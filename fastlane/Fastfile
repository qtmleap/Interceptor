# TestFlight release. The only upload entry point is `beta`, and it runs only in the verified CI
# workflow (.github/workflows/testflight.yaml). There is no local, manual or App Store lane.
require_relative "lib/release_pipeline"
require_relative "lib/fastlane_adapter"

REPO_ROOT = File.expand_path("..", __dir__)

default_platform(:ios)

platform :ios do
  desc "CI only: build the verified merge commit from a clean copy and upload it to TestFlight"
  lane :beta do
    # ReleasePipeline authorizes (CI context, exact live tip, clean checkout) before reading any
    # credential, creating a keychain or building.
    ReleasePipeline.run(adapter: FastlaneAdapter.new(self), repo_root: REPO_ROOT)
  end
end
