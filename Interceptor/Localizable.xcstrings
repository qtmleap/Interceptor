    "LABEL_GAME_WEB_TOKEN_EXPIRED_ACTION_FOOTER" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enabling regeneration reduces retrieval frequency but increases the risk of account suspension. Unless you have a specific reason, it is recommended to keep this disabled."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生成を有効化すると取得頻度は下がりますが、アカウント停止措置の可能性が高まります。特別な理由がない限り、無効にすることを推奨します。"
          }
        }
      }
    },
