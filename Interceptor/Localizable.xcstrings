    "EMPTY_REQUESTS_DESCRIPTION" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings → Capture Setup, finish the steps, then turn on Status to start capturing requests."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 →「キャプチャ設定」の手順を済ませ、接続状態をオンにすると通信履歴が表示されます。"
          }
        }
      }
    },
    "EMPTY_TOKENS_TITLE" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Tokens Yet"
          }
