    "CONSENT_WITHDRAW_CONFIRMATION" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stops the VPN and automatic reconnection and removes capture notifications. Saved data is not deleted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNと自動再接続を停止し、キャプチャ通知を削除します。保存済みのデータは削除しません。"
