    "SSL_LIST_RESET_CONFIRMATION" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The saved list can't be read. Resetting replaces it with the default hosts. Saved tokens and capture history are kept."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたリストを読み込めません。リセットすると初期のホストに置き換えます。保存済みのトークンと通信履歴は削除されません。"
          }
        }
      }
    },
    "SSL_LIST_ERROR_CORRUPT" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The saved list can't be read, so editing and capture are turned off until it is reset."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたリストを読み込めないため、リセットするまで編集とキャプチャは使用できません。"
          }
        }
      }
    },
    "SSL_LIST_ERROR_VERSION" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The saved list was made by a different version of the app, so editing and capture are turned off until it is reset."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
