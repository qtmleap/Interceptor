    "EMPTY_SETTINGS_DESCRIPTION" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose an item in the sidebar to view its details."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドバーの項目を選択すると、詳細が表示されます。"
