    "SSL_LIST_FOOTER" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes apply after stopping and starting the VPN. Only HTTPS (port 443) traffic to these exact hosts is captured. Apps that use certificate pinning may reject the certificate, so their content cannot be inspected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更はVPNを停止して再度開始すると反映されます。これらのホストへのHTTPS（ポート443）通信のみがキャプチャされます。証明書ピンニングを使用するアプリは証明書を拒否するため、内容を確認できない場合があります。"
          }
        }
