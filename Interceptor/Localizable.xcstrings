      }
    },
    "EMPTY_REQUESTS_TITLE" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Captured Requests"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通信履歴がありません"
